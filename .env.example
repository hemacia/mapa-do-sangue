# Copie para .env e ajuste. O docker compose lê este arquivo sozinho.

# Banco local (compose.yaml)
POSTGRES_USER=mapa
POSTGRES_PASSWORD=mapa
POSTGRES_DB=mapa
POSTGRES_PORT=5439

# API
API_PORT=8080
# Origem do site que pode chamar a API pelo navegador
ALLOWED_ORIGIN=http://localhost:3000
# Tempo para terminar as requisições em andamento ao desligar
SHUTDOWN_TIMEOUT=10s

# Testes do store fora do Docker (o banco do compose.yaml serve)
DATABASE_URL_TEST=postgres://mapa:mapa@localhost:5439/mapa?sslmode=disable
